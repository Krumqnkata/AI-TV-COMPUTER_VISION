# Server
# DATABASE_URL=postgresql+psycopg://user:password@localhost/school_ai
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_URL=http://localhost:5000
ADMIN_SECRET_KEY=replace-with-at-least-48-random-characters
DEVICE_API_KEY=replace-with-a-shared-random-device-key
COOKIE_SECURE=false

# Client node identity
CAMERA_SOURCE=0
CAMERA_ID=CAM-ENTRANCE-01
ZONE_ID=MAIN_ENTRANCE
SCREEN_ID=SCR-ENTRANCE-01
HTTP_TIMEOUT_SECONDS=10

# Optional AI providers
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Audio
PIPER_MODEL_PATH=engine/piper/bg_BG-dimitar-medium.onnx
