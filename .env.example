# Копирайте файла като .env.local. Никога не commit-вайте реални тайни.
# Това са единствените задължителни server стойности. Използвайте две различни тайни.
ADMIN_SECRET_KEY=replace-with-a-long-random-session-secret
SETTINGS_MASTER_KEY=replace-with-a-different-long-random-encryption-secret
DATABASE_URL=postgresql+psycopg://school_ai_app:replace-with-database-password@localhost:5432/school_ai_dev

# Незадължителни deployment overrides. Разкоментирайте само при нужда.
# COOKIE_SECURE=true
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5000
# POSTGRES_BIN_DIR=C:/Program Files/PostgreSQL/18/bin

# Незадължителни AI bootstrap/fallback стойности. Настройвайте AI основно от панела.
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-2.5-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Временен legacy fallback. Оставете го изключен след сдвояване на устройствата.
# DEVICE_API_KEY=

# Настройки за client устройство. Ползвайте ги само в .env.local на node машината.
# SERVER_URL=http://localhost:5000
# DEVICE_ID=kiosk-main-01
# DEVICE_KEY=
# DEVICE_NAME=Киоск при главния вход
# DEVICE_TYPE=camera_node
# DEVICE_ENROLLMENT_TOKEN=
# CAMERA_SOURCE=0
# CAMERA_ID=CAM-ENTRANCE-01
# ZONE_ID=MAIN_ENTRANCE
# SCREEN_ID=SCR-ENTRANCE-01
# HTTP_TIMEOUT_SECONDS=10
