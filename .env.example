# Deployment-only values. Never commit real secrets.
DATABASE_URL=sqlite:///data/school_ai.db
ADMIN_SECRET_KEY=replace-with-a-long-random-session-secret
SETTINGS_MASTER_KEY=replace-with-a-different-long-random-encryption-secret
COOKIE_SECURE=false
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_URL=http://localhost:5000

# Temporary compatibility key. Disable it from the panel after every device
# has its own DEVICE_ID + DEVICE_KEY.
DEVICE_API_KEY=replace-with-a-long-random-bootstrap-key

# Values below belong on each client device, not on the central server.
DEVICE_ID=kiosk-main-01
DEVICE_KEY=
DEVICE_NAME=Киоск при главния вход
DEVICE_TYPE=camera_node
DEVICE_ENROLLMENT_TOKEN=
CAMERA_ID=CAM-ENTRANCE-01
ZONE_ID=MAIN_ENTRANCE
SCREEN_ID=SCR-ENTRANCE-01
