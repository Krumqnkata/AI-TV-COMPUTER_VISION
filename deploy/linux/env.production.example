# Required production values. Replace every placeholder before startup.
DATABASE_URL=postgresql+psycopg://school_ai_app:URL_ENCODED_PASSWORD@localhost:5432/school_ai_prod
ADMIN_SECRET_KEY=replace-with-a-long-random-session-secret
SETTINGS_MASTER_KEY=replace-with-a-different-long-random-encryption-secret

# The application is reachable externally only through the TLS reverse proxy.
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SERVER_URL=https://school-ai.example.edu
COOKIE_SECURE=true

# Writable deployment boundaries owned by the unprivileged school-ai user.
BACKUP_DIR=/var/lib/school-ai/backups
IMPORT_DIR=/var/lib/school-ai/imports
LOGS_DIR=/var/log/school-ai
POSTGRES_BIN_DIR=/usr/bin
LOG_LEVEL=INFO

# Conservative single-process PostgreSQL pool.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
